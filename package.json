{
  "name": "@usenotra/mcp",
  "version": "1.1.0",
  "description": "MCP server for the Notra API",
  "mcpName": "io.github.usenotra/notra",
  "type": "module",
  "bin": {
    "notra-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:api-coverage": "pnpm run build && node scripts/check-api-coverage.mjs",
    "generate:output-schemas": "node scripts/generate-output-schemas.mjs",
    "check:output-schemas": "node scripts/generate-output-schemas.mjs --check"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/notra-mcp.git"
  },
  "keywords": [
    "mcp",
    "notra",
    "ai",
    "content"
  ],
  "author": "Notra",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/usenotra/notra-mcp/issues"
  },
  "homepage": "https://github.com/usenotra/notra-mcp#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@usenotra/geo": "^0.5.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^3.2.4",
    "prettier": "^3.9.4",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.34.5"
}
