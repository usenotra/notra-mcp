{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.usenotra/notra",
  "title": "Notra",
  "description": "Help your company show up in AI search. Track mentions, compare competitors, and find content gaps.",
  "repository": {
    "url": "https://github.com/usenotra/notra-mcp",
    "source": "github"
  },
  "version": "1.3.0",
  "websiteUrl": "https://www.usenotra.com",
  "icons": [
    {
      "src": "https://www.usenotra.com/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://www.usenotra.com/apple-icon.png",
      "mimeType": "image/png",
      "sizes": ["180x180"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.usenotra.com/mcp",
      "auth": {
        "posture": "required",
        "preferred": "oauth",
        "methods": [
          {
            "type": "oauth",
            "registration": "dynamic",
            "clientCredential": "none"
          },
          {
            "type": "headers",
            "headers": [
              {
                "name": "Authorization",
                "description": "Bearer Notra API key from Developer > API Keys",
                "isRequired": true,
                "isSecret": true
              },
              {
                "name": "X-Notra-Organization-Id",
                "description": "Workspace ID for an account API key that can access several workspaces",
                "isRequired": false,
                "isSecret": false
              }
            ]
          }
        ]
      }
    },
    {
      "type": "streamable-http",
      "url": "https://mcp.usenotra.com/mcp/{organization}",
      "auth": {
        "posture": "required",
        "preferred": "oauth",
        "methods": [
          {
            "type": "oauth",
            "registration": "dynamic",
            "clientCredential": "none"
          },
          {
            "type": "headers",
            "headers": [
              {
                "name": "Authorization",
                "description": "Bearer Notra API key from Developer > API Keys",
                "isRequired": true,
                "isSecret": true
              }
            ]
          }
        ]
      },
      "variables": {
        "organization": {
          "description": "Workspace ID or slug this connection acts on",
          "isRequired": true
        }
      }
    }
  ]
}
