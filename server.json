{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.usenotra/notra",
  "title": "Notra",
  "description": "Access the Notra API for managing posts, brand identities, integrations, schedules, and GEO: AI visibility scans, competitor share of voice, content briefs, and AI traffic analytics.",
  "repository": {
    "url": "https://github.com/usenotra/notra-mcp",
    "source": "github"
  },
  "version": "1.1.0",
  "websiteUrl": "https://www.usenotra.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.usenotra.com/mcp",
      "auth": {
        "posture": "required",
        "preferred": "oauth",
        "methods": [
          {
            "type": "oauth",
            "registration": "dynamic",
            "clientCredential": "none"
          },
          {
            "type": "headers",
            "headers": [
              {
                "name": "Authorization",
                "description": "Bearer Notra API key from Developer > API Keys",
                "isRequired": true,
                "isSecret": true
              }
            ]
          }
        ]
      }
    }
  ]
}
