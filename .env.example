NOTRA_API_KEY=your-api-key

# Optional HTTP resource-server OAuth settings
# WORKOS_AUTHKIT_DOMAIN=oauth.usenotra.com
# WORKOS_CLIENT_ID=client_xxx
# NOTRA_MCP_RESOURCE=https://mcp.usenotra.com

# Optional: point the server at a different Notra API (e.g. local development)
# NOTRA_API_BASE=http://localhost:3010

# Optional hosted HTTP usage collectors (never used by the stdio entry point)
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your-project-token
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# AXIOM_TOKEN=your-ingest-token
# AXIOM_MCP_DATASET=mcp-usage
# AXIOM_URL=https://api.axiom.co
# AXIOM_ORG_ID=your-axiom-org-id
